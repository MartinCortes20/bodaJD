---
/**
 * 09-GaleriaUno — Primera galería de fotos de las novias.
 * Composición: grid masonry-like (3 columnas, alturas variadas).
 * Fondo: navy.
 * TODO: Reemplazar placeholders con fotos reales.
 */
import Reveal from "../components/motion/Reveal.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import { weddingConfig } from "../../infrastructure/content/wedding.config";

// Fotos reales
const photos = [
  { src: "/assets/images/pareja/boda4.jpg", alt: `${weddingConfig.couple.name1} y ${weddingConfig.couple.name2} juntas`, width: 600, height: 800, tall: true },
  { src: "/assets/images/pareja/boda4.jpg", alt: `${weddingConfig.couple.name1} y ${weddingConfig.couple.name2} sonriendo`, width: 600, height: 450, tall: false },
  { src: "/assets/images/pareja/boda4.jpg", alt: `Las novias en su sesión de fotos`, width: 600, height: 450, tall: false },
  { src: "/assets/images/pareja/boda4.jpg", alt: `${weddingConfig.couple.name1} y ${weddingConfig.couple.name2} de cerca`, width: 600, height: 800, tall: true },
  { src: "/assets/images/pareja/boda4.jpg", alt: `Un momento especial de las novias`, width: 600, height: 450, tall: false },
  { src: "/assets/images/pareja/boda4.jpg", alt: `Las novias con el paisaje de fondo`, width: 600, height: 450, tall: false },
];
---

<section
  id="galeria-uno"
  class="bg-navy"
  style="padding-top: var(--section-py); padding-bottom: var(--section-py);"
  aria-labelledby="galeria1-heading"
>
  <div class="max-w-5xl mx-auto px-6">

    <Reveal>
      <div class="text-center mb-12">
        <p
          class="uppercase tracking-[0.3em] text-peach mb-4"
          style="font-size: var(--text-xs); font-family: var(--font-body);"
        >
          {/* TODO: revisar copy */}
          Nosotras
        </p>
        <SectionTitle
          text="Una historia de dos"
          id="galeria1-heading"
          color="cream"
        />
      </div>
    </Reveal>

    <div class="columns-2 md:columns-3 gap-3 space-y-3">
      {photos.map((photo, i) => (
        <Reveal delay={i * 80} class="break-inside-avoid">
          <figure class="overflow-hidden rounded-xl">
            <img
              src={photo.src}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading="lazy"
              decoding="async"
              class="w-full object-cover"
              style={photo.tall ? "aspect-ratio: 3/4;" : "aspect-ratio: 4/3;"}
            />
          </figure>
        </Reveal>
      ))}
    </div>

  </div>
</section>
