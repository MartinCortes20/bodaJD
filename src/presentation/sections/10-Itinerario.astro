---
/**
 * 10-Itinerario — Timeline vertical del día de la boda.
 * Fondo: cream.
 */
import Reveal from "../components/motion/Reveal.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import Icon from "../components/ui/Icon.astro";
import { itinerary } from "../../infrastructure/content/itinerary";
---

<section
  id="itinerario"
  class="bg-cream text-navy"
  style="padding-top: var(--section-py); padding-bottom: var(--section-py);"
  aria-labelledby="itinerario-heading"
>
  <div class="max-w-2xl mx-auto px-6">

    <Reveal>
      <div class="text-center mb-14">
        <p
          class="uppercase tracking-[0.3em] text-rose mb-4"
          style="font-size: var(--text-xs); font-family: var(--font-body);"
        >
          {/* TODO: revisar copy */}
          El día que se viene
        </p>
        <SectionTitle
          text="Itinerario"
          id="itinerario-heading"
          color="navy"
        />
      </div>
    </Reveal>

    <ol class="relative flex flex-col gap-0" aria-label="Programa del día">
      {itinerary.map((item, i) => {
        const isLast = i === itinerary.length - 1;
        return (
          <Reveal delay={i * 100}>
            <li class="relative flex gap-6 pb-10 last:pb-0">
              {/* Línea vertical de la timeline */}
              {!isLast && (
                <div
                  class="absolute left-[1.375rem] top-10 bottom-0 w-px bg-rose/20"
                  aria-hidden="true"
                ></div>
              )}

              {/* Indicador circular con número */}
              <div class="shrink-0 flex flex-col items-center" aria-hidden="true">
                <div
                  class="w-11 h-11 rounded-full bg-navy text-cream flex items-center justify-center text-base z-10 border-2 border-rose/30"
                  style="font-family: var(--font-display);"
                >
                  {i + 1}
                </div>
              </div>

              {/* Contenido */}
              <div class="pt-1 pb-2 flex-1 min-w-0">
                <div class="flex flex-wrap items-baseline gap-3 mb-1">
                  <time
                    class="text-rose font-semibold tabular-nums"
                    style="font-family: var(--font-body); font-size: var(--text-sm);"
                  >
                    {item.time} hrs
                  </time>
                  <span
                    class="text-navy font-medium inline-flex items-center gap-2"
                    style="font-family: var(--font-body); font-size: var(--text-base);"
                  >
                    <Icon name={item.icon as any} size={16} class="text-rose shrink-0" />
                    {item.title}
                  </span>
                </div>
                <p
                  class="text-navy/50 leading-relaxed"
                  style="font-family: var(--font-body); font-size: var(--text-sm);"
                >
                  {/* TODO: revisar copy */}
                  {item.description}
                </p>
              </div>
            </li>
          </Reveal>
        );
      })}
    </ol>

  </div>
</section>
