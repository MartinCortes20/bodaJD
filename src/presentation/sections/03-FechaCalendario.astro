---
/**
 * 03-FechaCalendario — Fecha grande + botón de agregar al calendario.
 * Fondo: navy.
 */
import Reveal from "../components/motion/Reveal.astro";
import Button from "../components/ui/Button.astro";
import { weddingConfig } from "../../infrastructure/content/wedding.config";

const eventDate = new Date(weddingConfig.date);

const dayName = eventDate.toLocaleDateString("es-MX", { weekday: "long" });
const dayNum = eventDate.toLocaleDateString("es-MX", { day: "numeric" });
const monthName = eventDate.toLocaleDateString("es-MX", { month: "long" });
const year = eventDate.getFullYear();

// Generar enlace para Google Calendar (mucho más confiable en mobile que el .ics en data URI)
const dtstart = weddingConfig.date.replace(/[-:]/g, "").split(".")[0];
// Para Google Calendar es mejor tener start y end, si no tenemos end asuminos +5 horas o lo dejamos igual (pero GCal requiere formato Z o YYYYMMDDTHHMMSS/YYYYMMDDTHHMMSS)
const gcalHref = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(`Boda de ${weddingConfig.couple.name1} y ${weddingConfig.couple.name2}`)}&dates=${dtstart}/${dtstart}&details=${encodeURIComponent("¡Nos casamos! Confirma tu asistencia en la invitación.")}&location=${encodeURIComponent(weddingConfig.ceremony.address)}`;
---

<section
  id="fecha-calendario"
  class="bg-navy text-cream"
  style="padding-top: var(--section-py); padding-bottom: var(--section-py);"
  aria-labelledby="fecha-heading"
>
  <div class="max-w-3xl mx-auto px-6 text-center">

    <Reveal>
      <p
        class="uppercase tracking-[0.3em] text-peach mb-6"
        style="font-size: var(--text-xs); font-family: var(--font-body);"
      >
        {/* TODO: revisar copy */}
        Guarda la fecha
      </p>
    </Reveal>

    <Reveal delay={80}>
      <p
        class="text-blush/60 capitalize mb-2"
        style="font-family: var(--font-body); font-size: var(--text-base);"
      >
        {dayName}
      </p>
    </Reveal>

    <Reveal delay={160}>
      <h2
        id="fecha-heading"
        class="text-cream leading-none mb-4"
        style="font-family: var(--font-display); font-size: var(--text-hero); letter-spacing: 0.05em;"
      >
        {dayNum}
      </h2>
    </Reveal>

    <Reveal delay={240}>
      <p
        class="text-peach capitalize mb-2"
        style="font-family: var(--font-display); font-size: var(--text-2xl); letter-spacing: 0.15em;"
      >
        {monthName}
      </p>
    </Reveal>

    <Reveal delay={300}>
      <p
        class="text-cream/50 mb-10"
        style="font-family: var(--font-body); font-size: var(--text-lg); letter-spacing: 0.2em;"
      >
        {year}
      </p>
    </Reveal>

    <Reveal delay={400}>
      {/* Hairline decorativa */}
      <div
        class="w-24 h-px bg-peach/40 mx-auto mb-10"
        aria-hidden="true"
      ></div>
    </Reveal>

    <Reveal delay={500}>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button
          href={gcalHref}
          variant="outline"
          target="_blank"
          id="btn-add-gcal"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
            <line x1="16" y1="2" x2="16" y2="6" />
            <line x1="8" y1="2" x2="8" y2="6" />
            <line x1="3" y1="10" x2="21" y2="10" />
          </svg>
          Google
        </Button>

        <Button
          href="/boda.ics"
          variant="outline"
          id="btn-add-apple"
          target="_blank"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 1.44C11 6.44 9.22 5 7 5a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z" />
            <path d="M10 2c1 .5 2 2 2 5" />
          </svg>
          Apple
        </Button>
      </div>
    </Reveal>

  </div>
</section>
