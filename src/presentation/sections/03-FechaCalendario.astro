---
/**
 * 03-FechaCalendario — Fecha grande + botón de agregar al calendario.
 * Fondo: navy.
 */
import Reveal from "../components/motion/Reveal.astro";
import Button from "../components/ui/Button.astro";
import { weddingConfig } from "../../infrastructure/content/wedding.config";

const eventDate = new Date(weddingConfig.date);

const dayName = eventDate.toLocaleDateString("es-MX", { weekday: "long" });
const dayNum = eventDate.toLocaleDateString("es-MX", { day: "numeric" });
const monthName = eventDate.toLocaleDateString("es-MX", { month: "long" });
const year = eventDate.getFullYear();

// Generar contenido .ics
const dtstart = weddingConfig.date.replace(/[-:]/g, "").replace("T", "T").split(".")[0];
const icsContent = [
  "BEGIN:VCALENDAR",
  "VERSION:2.0",
  "PRODID:-//Boda Dany y Jazmín//ES",
  "BEGIN:VEVENT",
  `DTSTART:${dtstart}`,
  `SUMMARY:Boda de ${weddingConfig.couple.name1} y ${weddingConfig.couple.name2} 💕`,
  `DESCRIPTION:¡Nos casamos! Confirma tu asistencia en la invitación.`,
  `LOCATION:${weddingConfig.ceremony.address}`,
  "END:VEVENT",
  "END:VCALENDAR",
].join("\r\n");

const icsHref = `data:text/calendar;charset=utf-8,${encodeURIComponent(icsContent)}`;
---

<section
  id="fecha-calendario"
  class="bg-navy text-cream"
  style="padding-top: var(--section-py); padding-bottom: var(--section-py);"
  aria-labelledby="fecha-heading"
>
  <div class="max-w-3xl mx-auto px-6 text-center">

    <Reveal>
      <p
        class="uppercase tracking-[0.3em] text-peach mb-6"
        style="font-size: var(--text-xs); font-family: var(--font-body);"
      >
        {/* TODO: revisar copy */}
        Guarda la fecha
      </p>
    </Reveal>

    <Reveal delay={80}>
      <p
        class="text-blush/60 capitalize mb-2"
        style="font-family: var(--font-body); font-size: var(--text-base);"
      >
        {dayName}
      </p>
    </Reveal>

    <Reveal delay={160}>
      <h2
        id="fecha-heading"
        class="text-cream leading-none mb-4"
        style="font-family: var(--font-display); font-size: var(--text-hero); letter-spacing: 0.05em;"
      >
        {dayNum}
      </h2>
    </Reveal>

    <Reveal delay={240}>
      <p
        class="text-peach capitalize mb-2"
        style="font-family: var(--font-display); font-size: var(--text-2xl); letter-spacing: 0.15em;"
      >
        {monthName}
      </p>
    </Reveal>

    <Reveal delay={300}>
      <p
        class="text-cream/50 mb-10"
        style="font-family: var(--font-body); font-size: var(--text-lg); letter-spacing: 0.2em;"
      >
        {year}
      </p>
    </Reveal>

    <Reveal delay={400}>
      {/* Hairline decorativa */}
      <div
        class="w-24 h-px bg-peach/40 mx-auto mb-10"
        aria-hidden="true"
      ></div>
    </Reveal>

    <Reveal delay={500}>
      <Button
        href={icsHref}
        variant="outline"
        target="_self"
        id="btn-add-calendar"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
        Agregar al calendario
      </Button>
    </Reveal>

  </div>
</section>
