---
/**
 * 13-Confirmacion — Formulario RSVP + botón WhatsApp como respaldo.
 * Fondo: navy.
 *
 * Lógica del formulario:
 * - Campos obligatorios: fullName, attending.
 * - Si attending === NOT_ATTENDING: oculta guestCount, companions, dietary.
 * - Validación client-side antes de enviar.
 * - Submit optimista → redirige a /gracias.
 * - Estados: idle | sending | error.
 */
import Reveal from "../components/motion/Reveal.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import { weddingConfig } from "../../infrastructure/content/wedding.config";
import { GOOGLE_FORM } from "../../infrastructure/config/googleForm";
---

<section
  id="confirmacion"
  class="bg-navy text-cream"
  style="padding-top: var(--section-py); padding-bottom: var(--section-py);"
  aria-labelledby="rsvp-heading"
>
  <div class="max-w-xl mx-auto px-6">

    <Reveal>
      <div class="text-center mb-12">
        <p
          class="uppercase tracking-[0.3em] text-peach mb-4"
          style="font-size: var(--text-xs); font-family: var(--font-body);"
        >
          {/* TODO: revisar copy */}
          ¿Nos acompañas?
        </p>
        <SectionTitle
          text="Confirma tu asistencia"
          id="rsvp-heading"
          color="cream"
          class="mb-4"
        />
        <p
          class="text-cream/50"
          style="font-family: var(--font-body); font-size: var(--text-sm);"
        >
          {/* TODO: revisar copy */}
          Te pedimos confirmar antes del 15 de noviembre. <!-- TODO: Actualizar fecha límite -->
        </p>
      </div>
    </Reveal>

    <Reveal delay={100}>
      <form
        id="rsvp-form"
        class="flex flex-col gap-6"
        novalidate
        aria-live="polite"
      >
        {/* Nombre completo */}
        <div class="flex flex-col gap-2">
          <label
            for="rsvp-name"
            class="text-blush uppercase tracking-widest"
            style="font-size: var(--text-xs); font-family: var(--font-body);"
          >
            Tu nombre completo <span class="text-rose" aria-label="obligatorio">*</span>
          </label>
          <input
            type="text"
            id="rsvp-name"
            name="fullName"
            required
            autocomplete="name"
            maxlength="120"
            placeholder="Como aparece en tu invitación"
            class="
              bg-navy-soft border border-peach/30 rounded-xl px-4 py-3
              text-cream placeholder-cream/20 w-full
              focus:outline-none focus:border-peach focus:ring-1 focus:ring-peach
              transition-colors duration-200
            "
            style="font-family: var(--font-body); font-size: var(--text-base);"
          />
          <p id="rsvp-name-error" class="text-rose text-xs hidden" role="alert"></p>
        </div>

        {/* ¿Asiste? */}
        <fieldset class="flex flex-col gap-3">
          <legend
            class="text-blush uppercase tracking-widest mb-2"
            style="font-size: var(--text-xs); font-family: var(--font-body);"
          >
            ¿Nos acompañas? <span class="text-rose" aria-label="obligatorio">*</span>
          </legend>

          <label
            class="flex items-center gap-3 cursor-pointer group"
            for="rsvp-yes"
          >
            <input
              type="radio"
              id="rsvp-yes"
              name="attending"
              value={GOOGLE_FORM.attendingValues.yes}
              class="
                w-5 h-5 accent-rose cursor-pointer
                focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-peach
              "
            />
            <span
              class="text-cream group-hover:text-peach transition-colors inline-flex items-center gap-2"
              style="font-family: var(--font-body);"
            >
              <Icon name="check" size={16} class="text-rose" />
              Sí, ahí estaré
            </span>
          </label>

          <label
            class="flex items-center gap-3 cursor-pointer group"
            for="rsvp-no"
          >
            <input
              type="radio"
              id="rsvp-no"
              name="attending"
              value={GOOGLE_FORM.attendingValues.no}
              class="
                w-5 h-5 accent-rose cursor-pointer
                focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-peach
              "
            />
            <span
              class="text-cream group-hover:text-peach transition-colors inline-flex items-center gap-2"
              style="font-family: var(--font-body);"
            >
              <Icon name="x" size={16} class="text-cream/40" />
              Lamentablemente no podré asistir
            </span>
          </label>
          <p id="rsvp-attending-error" class="text-rose text-xs hidden" role="alert"></p>
        </fieldset>

        {/* Campos condicionales — visibles solo si asiste */}
        <div id="rsvp-extra-fields" class="flex flex-col gap-6" aria-hidden="true" style="display: none;">

          {/* Número de personas */}
          <div class="flex flex-col gap-2">
            <label
              for="rsvp-count"
              class="text-blush uppercase tracking-widest"
              style="font-size: var(--text-xs); font-family: var(--font-body);"
            >
              ¿Cuántas personas van (incluyéndote)?
            </label>
            <select
              id="rsvp-count"
              name="guestCount"
              class="
                bg-navy-soft border border-peach/30 rounded-xl px-4 py-3
                text-cream w-full cursor-pointer appearance-none
                focus:outline-none focus:border-peach focus:ring-1 focus:ring-peach
                transition-colors duration-200
              "
              style="font-family: var(--font-body); font-size: var(--text-base);"
            >
              {Array.from({ length: 11 }, (_, i) => i + 1).map((n) => (
                <option value={n}>{n} {n === 1 ? "persona" : "personas"}</option>
              ))}
            </select>
          </div>

          {/* Nombres de acompañantes */}
          <div class="flex flex-col gap-2">
            <label
              for="rsvp-companions"
              class="text-blush uppercase tracking-widest"
              style="font-size: var(--text-xs); font-family: var(--font-body);"
            >
              Nombres de tus acompañantes <span class="text-cream/30">(opcional)</span>
            </label>
            <input
              type="text"
              id="rsvp-companions"
              name="companions"
              placeholder="Separados por coma"
              class="
                bg-navy-soft border border-peach/30 rounded-xl px-4 py-3
                text-cream placeholder-cream/20 w-full
                focus:outline-none focus:border-peach focus:ring-1 focus:ring-peach
                transition-colors duration-200
              "
              style="font-family: var(--font-body); font-size: var(--text-base);"
            />
          </div>

          {/* Restricciones alimentarias */}
          <div class="flex flex-col gap-2">
            <label
              for="rsvp-dietary"
              class="text-blush uppercase tracking-widest"
              style="font-size: var(--text-xs); font-family: var(--font-body);"
            >
              Restricciones alimentarias <span class="text-cream/30">(opcional)</span>
            </label>
            <input
              type="text"
              id="rsvp-dietary"
              name="dietary"
              placeholder="Alergias, vegetariano, vegano…"
              class="
                bg-navy-soft border border-peach/30 rounded-xl px-4 py-3
                text-cream placeholder-cream/20 w-full
                focus:outline-none focus:border-peach focus:ring-1 focus:ring-peach
                transition-colors duration-200
              "
              style="font-family: var(--font-body); font-size: var(--text-base);"
            />
          </div>

        </div>

        {/* Canción — visible siempre */}
        <div class="flex flex-col gap-2">
          <label
            for="rsvp-song"
            class="text-blush uppercase tracking-widest"
            style="font-size: var(--text-xs); font-family: var(--font-body);"
          >
            Una canción que no puede faltar <span class="text-cream/30">(opcional)</span>
          </label>
          <input
            type="text"
            id="rsvp-song"
            name="song"
            placeholder="Artista — Canción"
            class="
              bg-navy-soft border border-peach/30 rounded-xl px-4 py-3
              text-cream placeholder-cream/20 w-full
              focus:outline-none focus:border-peach focus:ring-1 focus:ring-peach
              transition-colors duration-200
            "
            style="font-family: var(--font-body); font-size: var(--text-base);"
          />
        </div>

        {/* Error general */}
        <p
          id="rsvp-general-error"
          class="text-rose text-sm hidden"
          role="alert"
          aria-live="assertive"
        ></p>

        {/* Submit */}
        <Button
          type="submit"
          variant="primary"
          id="rsvp-submit"
          class="w-full justify-center text-base py-4"
        >
          <span id="rsvp-btn-label">Confirmar asistencia</span>
        </Button>

      </form>
    </Reveal>

    {/* Separador */}
    <Reveal delay={200}>
      <div class="flex items-center gap-4 my-10" aria-hidden="true">
        <div class="h-px bg-peach/20 flex-1"></div>
        <span class="text-peach/40 text-xs uppercase tracking-widest" style="font-family: var(--font-body);">o también</span>
        <div class="h-px bg-peach/20 flex-1"></div>
      </div>
    </Reveal>

    {/* Botón WhatsApp */}
    <Reveal delay={300}>
      <div class="text-center">
        <p
          class="text-cream/40 mb-4"
          style="font-family: var(--font-body); font-size: var(--text-sm);"
        >
          {/* TODO: revisar copy */}
          Si tienes problemas con el formulario, escríbenos directamente:
        </p>
        <Button
          id="btn-whatsapp"
          variant="outline"
          class="w-full justify-center"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          Confirmar por WhatsApp
        </Button>
      </div>
    </Reveal>

  </div>
</section>

<script>
  import { SubmitRsvp } from "../../application/use-cases/SubmitRsvp";
  import { GoogleFormRsvpRepository } from "../../infrastructure/repositories/GoogleFormRsvpRepository";
  import { WhatsAppRsvpRepository } from "../../infrastructure/repositories/WhatsAppRsvpRepository";
  import { AttendanceStatus } from "../../domain/value-objects/AttendanceStatus";
  import { validateFormConfig } from "../../infrastructure/config/googleForm";
  import { validateWeddingConfig } from "../../infrastructure/content/wedding.config";

  // Validar configs al cargar
  validateFormConfig();
  validateWeddingConfig();

  const form = document.getElementById("rsvp-form") as HTMLFormElement | null;
  const extraFields = document.getElementById("rsvp-extra-fields");
  const submitBtn = document.getElementById("rsvp-submit") as HTMLButtonElement | null;
  const btnLabel = document.getElementById("rsvp-btn-label");
  const whatsappBtn = document.getElementById("btn-whatsapp") as HTMLButtonElement | null;

  // ── Toggle campos condicionales ──────────────────────────────────
  function updateExtraFields() {
    const attendingValue = (form?.querySelector('input[name="attending"]:checked') as HTMLInputElement | null)?.value;
    const isAttending = attendingValue === AttendanceStatus.ATTENDING ||
      (attendingValue && !attendingValue.includes("No podré"));

    // Usamos el valor del radio (que es el string de Google Form)
    const radioYes = document.getElementById("rsvp-yes") as HTMLInputElement | null;
    const attending = radioYes?.checked;

    if (extraFields) {
      extraFields.style.display = attending ? "flex" : "none";
      extraFields.setAttribute("aria-hidden", attending ? "false" : "true");
    }
  }

  form?.querySelectorAll('input[name="attending"]').forEach((radio) => {
    radio.addEventListener("change", updateExtraFields);
  });

  // ── Validación ───────────────────────────────────────────────────
  function showError(id: string, message: string) {
    const el = document.getElementById(id);
    if (el) {
      el.textContent = message;
      el.classList.remove("hidden");
    }
  }

  function clearErrors() {
    ["rsvp-name-error", "rsvp-attending-error", "rsvp-general-error"].forEach((id) => {
      const el = document.getElementById(id);
      if (el) {
        el.textContent = "";
        el.classList.add("hidden");
      }
    });
  }

  function validate(): boolean {
    clearErrors();
    let valid = true;

    const nameInput = document.getElementById("rsvp-name") as HTMLInputElement | null;
    if (!nameInput?.value.trim()) {
      showError("rsvp-name-error", "El nombre es obligatorio.");
      nameInput?.focus();
      valid = false;
    }

    const attendingChecked = form?.querySelector('input[name="attending"]:checked');
    if (!attendingChecked) {
      showError("rsvp-attending-error", "Indica si asistirás o no.");
      valid = false;
    }

    return valid;
  }

  // ── Submit principal (Google Form) ───────────────────────────────
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!validate()) return;

    const data = new FormData(form);
    const nameInput = document.getElementById("rsvp-name") as HTMLInputElement;
    const radioYes = document.getElementById("rsvp-yes") as HTMLInputElement;
    const countSelect = document.getElementById("rsvp-count") as HTMLSelectElement;
    const companionsInput = document.getElementById("rsvp-companions") as HTMLInputElement;
    const dietaryInput = document.getElementById("rsvp-dietary") as HTMLInputElement;
    const songInput = document.getElementById("rsvp-song") as HTMLInputElement;

    const attending = radioYes?.checked
      ? AttendanceStatus.ATTENDING
      : AttendanceStatus.NOT_ATTENDING;

    try {
      // Estado: enviando
      if (submitBtn) submitBtn.disabled = true;
      if (btnLabel) btnLabel.textContent = "Enviando…";

      const repository = new GoogleFormRsvpRepository();
      const useCase = new SubmitRsvp(repository);

      await useCase.execute({
        fullName: nameInput?.value ?? "",
        attending,
        guestCount: attending === AttendanceStatus.ATTENDING
          ? parseInt(countSelect?.value ?? "1", 10)
          : undefined,
        companions: companionsInput?.value || undefined,
        dietary: dietaryInput?.value || undefined,
        song: songInput?.value || undefined,
      });

      // Redirect optimista (el envío es opaco, no podemos leer el status)
      window.location.href = "/gracias";

    } catch (err) {
      if (submitBtn) submitBtn.disabled = false;
      if (btnLabel) btnLabel.textContent = "Confirmar asistencia";

      const errorMsg = err instanceof Error ? err.message : "Algo salió mal. Intenta de nuevo.";
      showError("rsvp-general-error", errorMsg);
    }
  });

  // ── Botón WhatsApp ───────────────────────────────────────────────
  whatsappBtn?.addEventListener("click", async () => {
    if (!validate()) return;

    const nameInput = document.getElementById("rsvp-name") as HTMLInputElement;
    const radioYes = document.getElementById("rsvp-yes") as HTMLInputElement;
    const countSelect = document.getElementById("rsvp-count") as HTMLSelectElement;
    const companionsInput = document.getElementById("rsvp-companions") as HTMLInputElement;
    const dietaryInput = document.getElementById("rsvp-dietary") as HTMLInputElement;
    const songInput = document.getElementById("rsvp-song") as HTMLInputElement;

    const attending = radioYes?.checked
      ? AttendanceStatus.ATTENDING
      : AttendanceStatus.NOT_ATTENDING;

    try {
      const repo = new WhatsAppRsvpRepository();
      const useCase = new SubmitRsvp(repo);

      await useCase.execute({
        fullName: nameInput?.value ?? "",
        attending,
        guestCount: attending === AttendanceStatus.ATTENDING
          ? parseInt(countSelect?.value ?? "1", 10)
          : undefined,
        companions: companionsInput?.value || undefined,
        dietary: dietaryInput?.value || undefined,
        song: songInput?.value || undefined,
      });
    } catch (err) {
      const errorMsg = err instanceof Error ? err.message : "No se pudo abrir WhatsApp.";
      showError("rsvp-general-error", errorMsg);
    }
  });
</script>
