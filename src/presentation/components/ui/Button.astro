---
/**
 * Button — Botón accesible con variantes y soporte para link/botón.
 * Touch target mínimo 44×44px.
 */
interface Props {
  variant?: "primary" | "outline" | "ghost";
  href?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  class?: string;
  id?: string;
  "aria-label"?: string;
  target?: "_blank" | "_self";
  rel?: string;
}

const {
  variant = "primary",
  href,
  type = "button",
  disabled = false,
  class: extraClass = "",
  id,
  "aria-label": ariaLabel,
  target,
  rel,
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 font-body font-medium rounded-full transition-all duration-300 cursor-pointer min-h-[44px] px-6 py-2.5 text-sm tracking-wide focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-peach";

const variants = {
  primary:
    "bg-rose text-navy hover:bg-peach active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed",
  outline:
    "border border-peach text-cream hover:bg-navy-soft active:scale-95 disabled:opacity-50",
  ghost:
    "text-cream hover:text-peach underline underline-offset-4 decoration-peach/40 hover:decoration-peach",
};

const Tag = href ? "a" : "button";
---

{
  href ? (
    <a
      id={id}
      href={href}
      class:list={[base, variants[variant], extraClass]}
      aria-label={ariaLabel}
      target={target}
      rel={target === "_blank" ? "noopener noreferrer" : rel}
    >
      <slot />
    </a>
  ) : (
    <button
      id={id}
      type={type}
      disabled={disabled}
      class:list={[base, variants[variant], extraClass]}
      aria-label={ariaLabel}
    >
      <slot />
    </button>
  )
}
