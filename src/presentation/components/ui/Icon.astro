---
/**
 * Icon.astro — Biblioteca de íconos SVG inline para el proyecto.
 * Todos los íconos son de estilo Lucide (stroke, no fill).
 * Accesibilidad: siempre lleva aria-hidden="true" a menos que se
 * pase un aria-label explícito.
 */
interface Props {
  name:
    | "ring"
    | "glasses"
    | "clock"
    | "no-phone"
    | "wine"
    | "walk"
    | "cake"
    | "music-note"
    | "moon"
    | "fork-knife"
    | "gift"
    | "envelope"
    | "heart"
    | "warning"
    | "sparkle"
    | "check"
    | "x"
    | "calendar"
    | "map-pin"
    | "chevron-down"
    | "play"
    | "pause"
    | "whatsapp"
    | "external-link"
    | "users";
  size?: number;
  class?: string;
  "aria-hidden"?: "true" | "false";
  "aria-label"?: string;
  strokeWidth?: number;
}

const {
  name,
  size = 20,
  class: extraClass = "",
  "aria-hidden": ariaHidden = "true",
  "aria-label": ariaLabel,
  strokeWidth = 1.5,
} = Astro.props;

// Paths de cada ícono
const icons: Record<string, string> = {
