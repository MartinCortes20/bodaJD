  clock: `<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>`,
  "no-phone": `<line x1="2" y1="2" x2="22" y2="22"/><path d="M16.5 16.5 8 8a2 2 0 0 0-2.83 0l-1.17 1.17a2 2 0 0 0 0 2.83l9 9a2 2 0 0 0 2.83 0l1.17-1.17a2 2 0 0 0 0-2.83z"/><path d="M14.5 2.5h-5a2 2 0 0 0-2 2v1.5"/>`,
  wine: `<path d="M8 22h8"/><path d="M7 10h10"/><path d="M12 15v7"/><path d="M12 15a5 5 0 0 0 5-5c0-2-.5-4-2-8H9c-1.5 4-2 6-2 8a5 5 0 0 0 5 5z"/>`,
  walk: `<circle cx="12" cy="5" r="1"/><path d="m9 20 3-6 3 6"/><path d="m6 8 2 4h8l2-4"/><path d="m9 14-3 6"/><path d="m15 14 3 6"/>`,
  cake: `<path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"/><path d="M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1"/><path d="M2 21h20"/><path d="M7 8v3"/><path d="M12 8v3"/><path d="M17 8v3"/><path d="M7 4h.01"/><path d="M12 4h.01"/><path d="M17 4h.01"/>`,
  "music-note": `<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>`,
